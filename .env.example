# Anthropic: Fable (stage 3), Sonnet (gatherer), corpus build scripts.
ANTHROPIC_API_KEY=
# Turns the harness on (entry.ts declines otherwise).
GEOLOGY_HARNESS=1
# Optional: defaults to ./geology-corpus. Needed by figure-image.ts to read figures from disk.
GEOLOGY_CORPUS_ROOT=
# Python tool service. `npm run dev:tools` serves it here.
GEOLOGY_TOOLS_URL=http://127.0.0.1:8781
# Tiger RRC mirror, read-only role (rrc + cad schemas). Never Wildcat's credential.
RRC_DATABASE_URL=
# Wildcat's Supabase project: sign-in uses Wildcat accounts. Publishable key only;
# every read runs as the signed-in user under RLS. Never the secret key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Wildcat's web app. Sign-up, password reset, onboarding, settings and help live there.
NEXT_PUBLIC_WILDCAT_URL=
# Gemini: log digitizer (redraw + depth labels).
GEMINI_API_KEY=
# Mapbox public token: the subsurface map. Same token as Wildcat.
NEXT_PUBLIC_MAPBOX_TOKEN=
